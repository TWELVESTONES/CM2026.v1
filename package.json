{
  "name": "cloudmerge",
  "productName": "CloudMerge",
  "version": "0.1.16",
  "description": "Free, open-source app that unifies Google Drive, OneDrive, Dropbox (and more) into one local folder on your own machine, powered by rclone. Nothing routes through a third-party server.",
  "main": "src/main/index.js",
  "author": "James Woodley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TWELVESTONES/CM2026.v1.git"
  },
  "homepage": "https://github.com/TWELVESTONES/CM2026.v1#readme",
  "bugs": {
    "url": "https://github.com/TWELVESTONES/CM2026.v1/issues"
  },
  "keywords": ["rclone", "cloud-storage", "google-drive", "onedrive", "dropbox", "unified-drive"],
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "auto-launch": "^5.0.6"
  },
  "build": {
    "appId": "com.cloudmerge.app",
    "productName": "CloudMerge",
    "publish": null,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/licenses",
        "to": "licenses",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "extraResources": [
        { "from": "resources/bin/win", "to": "bin", "filter": ["**/*"] },
        { "from": "resources/winfsp", "to": "winfsp", "filter": ["**/*"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "include": "installer.nsh"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.utilities",
      "extraResources": [
        { "from": "resources/bin/mac", "to": "bin", "filter": ["**/*"] }
      ]
    }
  }
}
